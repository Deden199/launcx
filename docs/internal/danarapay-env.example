# =====================================================
# DanaRpay VA Aggregator - Environment Variables
# =====================================================
# Tambahkan ke file .env existing

# DanaRpay Base URL
# Production: https://partner.danarapay.com
# Staging: https://api-stg.danarapay.com
DANARAPAY_BASE_URL=https://api-stg.danarapay.com

# Credentials dari DanaRpay Dashboard
DANARAPAY_USERNAME=your_username_here
DANARAPAY_API_KEY=your_api_key_here
